@model List<MyStoreMVC5.Models.AppUser>
@{ ViewBag.Title = "Tài khoản Admin"; }
<div class="stack" style="justify-content:space-between"><h1>Tài khoản Admin</h1>
<a class="button" href="@Url.Action("Create")">+ Tạo Admin</a></div>
<form method="get" class="toolbar">
<div class="field"><label>Tên đăng nhập</label><input name="search" value="@ViewBag.Search" /></div>
<button type="submit">Tìm kiếm</button></form>
<div class="table-wrap"><table><thead><tr><th>Tên đăng nhập</th><th>Tác vụ</th></tr></thead>
@foreach(var user in Model) {
 <tr><td>@user.Username</td><td class="actions">
 <a href="@Url.Action("Edit",new { id=user.Username })">Sửa mật khẩu</a>
 <a href="@Url.Action("Delete",new { id=user.Username })">Xóa</a></td></tr>
}
</table></div>
<div class="pagination">@for(int i=1;i<=(int)ViewBag.Pages;i++){
<a class="page @(i==(int)ViewBag.Page?"active":"")" href="@Url.Action("Index",new { search=ViewBag.Search,page=i })">@i</a>
}</div>
