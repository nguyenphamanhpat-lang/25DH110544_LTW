@model MyStoreMVC5.Models.StoreOrder
@{ ViewBag.Title = "Đơn hàng #" + Model.OrderID; }
<h1>Đơn hàng #@Model.OrderID</h1>
<p><strong>Khách hàng:</strong> @(Model.Customer == null ? "—" : Model.Customer.CustomerName)</p>
<p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</p>
<p><strong>Địa chỉ giao:</strong> @Model.AddressDelivery</p>
<p><strong>Trạng thái:</strong> @Model.PaymentStatus</p>
<div class="table-wrap"><table>
<thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
@foreach(var line in Model.OrderDetails){
<tr><td>@(line.Product==null?"—":line.Product.ProductName)</td><td>@line.UnitPrice.ToString("N0") ₫</td>
<td>@line.Quantity</td><td>@((line.UnitPrice*line.Quantity).ToString("N0")) ₫</td></tr>
}
</table></div>
<h2>Tổng đơn: @Model.TotalAmount.ToString("N0") ₫</h2>
<div class="summary">
<h3>Cập nhật trạng thái thanh toán</h3>
@using(Html.BeginForm("SetStatus","Orders",FormMethod.Post)) {
 @Html.AntiForgeryToken()
 <input type="hidden" name="id" value="@Model.OrderID" />
 <div class="stack"><select name="status" style="max-width:280px">
   <option value="COD_PENDING" @(Model.PaymentStatus=="COD_PENDING"?"selected":"")>Chờ thu COD</option>
   <option value="PAID" @(Model.PaymentStatus=="PAID"?"selected":"")>Đã thanh toán</option>
   <option value="CANCELLED" @(Model.PaymentStatus=="CANCELLED"?"selected":"")>Đã hủy</option>
 </select><button type="submit">Lưu trạng thái</button></div>
}
</div>
<p><a href="@Url.Action("Index")">← Danh sách đơn hàng</a></p>
