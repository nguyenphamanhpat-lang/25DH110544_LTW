@model List<MyStoreMVC5.Models.StoreOrder>
@{ ViewBag.Title="Quản lý đơn hàng"; }
<h1>Danh sách đơn hàng</h1>
<form method="get" class="toolbar">
<div class="field"><label>Khách hàng / Username</label><input name="search" value="@ViewBag.Search" /></div>
<div class="field"><label>Sắp xếp</label><select name="sort">
<option value="newest" @(ViewBag.Sort=="newest"?"selected":"")>Mới nhất</option>
<option value="oldest" @(ViewBag.Sort=="oldest"?"selected":"")>Cũ nhất</option>
<option value="total_desc" @(ViewBag.Sort=="total_desc"?"selected":"")>Giá trị giảm dần</option>
</select></div>
<button type="submit">Tìm kiếm</button>
</form>
<div class="table-wrap"><table>
<thead><tr><th>Mã</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
@foreach(var order in Model){
<tr><td>#@order.OrderID</td><td>@(order.Customer==null?"—":order.Customer.CustomerName)</td>
<td>@order.OrderDate.ToString("dd/MM/yyyy")</td><td>@order.TotalAmount.ToString("N0") ₫</td>
<td>@order.PaymentStatus</td><td><a href="@Url.Action("Details",new { id=order.OrderID })">Chi tiết</a></td></tr>
}
</table></div>
<div class="pagination">@for(int i=1;i<=(int)ViewBag.Pages;i++){
<a class="page @(i==(int)ViewBag.Page?"active":"")" href="@Url.Action("Index",new { search=ViewBag.Search,sort=ViewBag.Sort,page=i })">@i</a>
}</div>
