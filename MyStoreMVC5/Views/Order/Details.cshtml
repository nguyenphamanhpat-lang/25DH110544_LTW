@model MyStoreMVC5.Models.StoreOrder
@{ ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID; }
<h1>Đơn hàng #@Model.OrderID</h1>
<p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy") · <strong>Trạng thái:</strong> @Model.PaymentStatus</p>
<p><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p>
<div class="table-wrap"><table>
<thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead>
@foreach(var line in Model.OrderDetails) {
<tr><td>@(line.Product == null ? "Sản phẩm" : line.Product.ProductName)</td><td>@line.UnitPrice.ToString("N0") ₫</td>
<td>@line.Quantity</td><td>@((line.UnitPrice * line.Quantity).ToString("N0")) ₫</td></tr>
}
</table></div>
<h2>Tổng thanh toán: @Model.TotalAmount.ToString("N0") ₫</h2>
<a href="@Url.Action("OrderHistory","Order")">← Quay về lịch sử</a>
