@model _25DH110544_LTW.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h2>

<div class="panel panel-default">
    <div class="panel-heading"><strong>Thông tin đơn hàng</strong></div>
    <div class="panel-body">
        <p><strong>Ngày đặt hàng:</strong> @(Model.OrderDate != null ? Convert.ToDateTime(Model.OrderDate).ToString("dd/MM/yyyy HH:mm") : "")</p>
        <p><strong>Khách hàng:</strong> @(Model.Customer != null ? Model.Customer.CustomerName : "Khách vãng lai")</p>
        <p><strong>Số điện thoại:</strong> @(Model.Customer != null ? Model.Customer.CustomerPhone : "")</p>
        <p><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p>
        <p><strong>Tổng tiền:</strong> <span class="text-danger">@Model.TotalAmount VNĐ</span></p>
    </div>
</div>

<h3>Danh sách sản phẩm trong đơn hàng</h3>
<table class="table table-bordered table-striped">
    <tr>
        <th>Hình ảnh</th>
        <th>Tên sản phẩm</th>
        <th>Số lượng</th>
        <th>Đơn giá</th>
        <th>Thành tiền</th>
    </tr>

    @foreach (var detail in Model.OrderDetails)
    {
        <tr>
            <td>
                @if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ProductImage))
                {
                    <img src="@Url.Content(detail.Product.ProductImage)" style="height: 60px; width: 60px; object-fit: cover;" />
                }
            </td>
            <td>@(detail.Product != null ? detail.Product.ProductName : "Sản phẩm không tồn tại")</td>
            <td>@detail.Quantity</td>
            <td>@detail.UnitPrice</td>
            <td>@(detail.Quantity * detail.UnitPrice)</td>
        </tr>
    }
</table>

<p>
    @Html.ActionLink("Cập nhật trạng thái", "Edit", new { id = Model.OrderID }, new { @class = "btn btn-primary" }) |
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
</p>