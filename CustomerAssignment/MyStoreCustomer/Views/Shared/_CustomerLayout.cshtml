<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewBag.Title - MyStore</title><link rel="stylesheet" href="@Url.Content("~/Content/site.css")"/></head><body><header><div class="wrap nav"><a class="logo" href="@Url.Action("MyOrder","Customer")">MyStore</a><nav><a href="@Url.Action("MyOrder","Customer")">Đơn hàng của tôi</a>@if(User.Identity.IsAuthenticated){<span>@User.Identity.Name</span><form method="post" action="@Url.Action("Logout","Account")">@Html.AntiForgeryToken()<button>Đăng xuất</button></form>}</nav></div></header><main class="wrap">@if(TempData["Message"]!=null){<p class="notice">@TempData["Message"]</p>}@RenderBody()</main><footer>MyStore - Khu vực khách hàng</footer></body></html>