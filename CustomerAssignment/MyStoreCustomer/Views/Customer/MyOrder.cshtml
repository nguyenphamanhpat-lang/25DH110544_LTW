@model MyOrderViewModel
@{ ViewBag.Title="Đơn hàng của tôi"; var tabs=new[]{new{Key="all",Name="Tất cả đơn"},new{Key="PendingPayment",Name="Chờ thanh toán"},new{Key="Processing",Name="Đang xử lý"},new{Key="Shipping",Name="Đang vận chuyển"},new{Key="Delivered",Name="Đã giao"},new{Key="Cancelled",Name="Đã hủy"}}; }
<div class="hero"><b>MUA SẮM THÔNG MINH</b><h2>ƯU ĐÃI CỰC ĐÃ</h2><p>Theo dõi đơn hàng dễ dàng tại iza shop.</p></div><h1>Đơn hàng của tôi</h1>
<form method="get" class="search"><label>Tìm kiếm đơn hàng:</label><input name="search" value="@Model.Search" placeholder="Nhập mã đơn hàng hoặc tên sản phẩm..."/><input type="hidden" name="status" value="@Model.Status"/><button>Tìm kiếm</button></form>
<div class="tabs">@foreach(var t in tabs){<a class="@(Model.Status==t.Key?"active":"")" href="@Url.Action("MyOrder",new{status=t.Key,search=Model.Search})">@t.Name</a>}</div>
@if(!Model.Orders.Any()){<section class="order"><b>BẠN CHƯA CÓ ĐƠN HÀNG NÀO. HÃY ĐẶT ĐƠN NGAY.</b></section>}
@foreach(var o in Model.Orders){<section class="order"><div class="head"><b>Mã đơn hàng: #@o.OrderID</b><span>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</span><strong>@o.Status</strong></div>@foreach(var d in o.OrderDetails){<div class="product"><img class="product-image" src="@Url.Content("~/Content/Images/"+(String.IsNullOrWhiteSpace(d.Product.ProductImage)?"earbuds.jpg":d.Product.ProductImage))" alt="@d.Product.ProductName"/><div class="product-info"><b>@d.Product.ProductName</b><small>Đơn giá: @d.UnitPrice.ToString("N0") ₫ · Số lượng: @d.Quantity</small></div><b>@((d.UnitPrice*d.Quantity).ToString("N0")) ₫</b><form method="post" action="@Url.Action("BuyAgain","Customer")">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@d.ProductID"/><button>Mua lại</button></form><a href="@Url.Action("OrderDetails",new{id=o.OrderID})">Xem chi tiết</a></div>}<div class="foot"><b>Tổng tiền: <span>@o.TotalAmount.ToString("N0") ₫</span></b></div></section>}
@if(Model.TotalCount>Model.Orders.Count&&Model.Orders.Count<50){<a class="more" href="@Url.Action("MyOrder",new{status=Model.Status,search=Model.Search,page=Model.Page+1})">Xem thêm</a>}