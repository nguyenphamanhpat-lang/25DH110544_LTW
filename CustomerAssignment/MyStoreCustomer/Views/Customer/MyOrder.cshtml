@model MyOrderViewModel
@{ViewBag.Title="Đơn hàng của tôi";var tabs=new[]{new{Key="all",Name="Tất cả đơn"},new{Key="PendingPayment",Name="Chờ thanh toán"},new{Key="Processing",Name="Đang xử lý"},new{Key="Shipping",Name="Đang vận chuyển"},new{Key="Delivered",Name="Đã giao"},new{Key="Cancelled",Name="Đã hủy"}};}
<h1>Đơn hàng của tôi</h1><form method="get" class="search"><input name="search" value="@Model.Search" placeholder="Tìm theo mã đơn hoặc tên sản phẩm"/><input type="hidden" name="status" value="@Model.Status"/><button>Tìm kiếm</button></form><div class="tabs">@foreach(var t in tabs){<a class="@(Model.Status==t.Key?"active":"")" href="@Url.Action("MyOrder",new{status=t.Key,search=Model.Search})">@t.Name</a>}</div>
@if(!Model.Orders.Any()){<section class="empty"><b>BẠN CHƯA CÓ ĐƠN HÀNG NÀO. HÃY ĐẶT ĐƠN NGAY.</b><p><a href="@Url.Action("Index","Home")">Về trang chủ</a></p></section>}
@foreach(var o in Model.Orders){<section class="order"><div class="head"><b>Đơn hàng #@o.OrderID</b><span>@o.OrderDate.ToString("dd/MM/yyyy")</span><strong>@o.Status</strong></div>@foreach(var d in o.OrderDetails){<div class="product"><div><b>@d.Product.ProductName</b><small>@d.UnitPrice.ToString("N0") ₫ · SL: @d.Quantity</small></div><b>@((d.UnitPrice*d.Quantity).ToString("N0")) ₫</b><form method="post" action="@Url.Action("BuyAgain","Customer")">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@d.ProductID"/><button>Mua lại</button><a href="@Url.Action("ProductDetail","Home",new{id=d.ProductID})">Xem sản phẩm</a></form></div>}<div class="foot"><b>Tổng tiền: @o.TotalAmount.ToString("N0") ₫</b><a href="@Url.Action("OrderDetails",new{id=o.OrderID})">Chi tiết đơn hàng</a></div></section>}
@if(Model.TotalCount>Model.Orders.Count && Model.Orders.Count<50){<a class="more" href="@Url.Action("MyOrder",new{status=Model.Status,search=Model.Search,page=Model.Page+1})">Xem thêm</a>}